programa Parcial09062025

procesos
  
  {PROCESOS EQUIPO AZUL}
  
  proceso buscarFlorBase
  variables  
    avOri, caOri: numero
  comenzar
    avOri:= PosAv
    caOri:= PosCa
    BloquearEsquina(12,11)
    Pos(12,11)
    tomarFlor
    Pos(avOri+1, caOri)
    LiberarEsquina(12,11)
  fin
  
  proceso depositarFlorBase (E av: numero; E ca: numero)
  comenzar
    BloquearEsquina(12,11)
    Pos(12,11)
    depositarFlor
    Pos(av,ca)
    LiberarEsquina(12,11)
  fin
  
  
  {PROCESOS EQUIPO VERDE}
  
  proceso buscarPapelBase
  variables
    avOri, caOri: numero
  comenzar
    avOri:= PosAv
    caOri:= PosCa
    BloquearEsquina(12,11)
    Pos(12,11)
    tomarPapel
    Pos(avOri+1, caOri)
    LiberarEsquina(12,11)
  fin
  
  proceso depositarPapelBase (E av: numero; E ca: numero)
  comenzar
    BloquearEsquina(12,11)
    Pos(12,11)
    depositarPapel
    Pos(av,ca)
    LiberarEsquina(12,11)
  fin
  
areas
  areaFuenteFlores: AreaP (10,12,10,12)
  areaFuentePapeles: AreaP (10,10,10,10)
  
  areaRecolectorAzul: AreaP (11,12,11,12)
  areaDepositadorAzul: AreaP (12,12,20,12)
  
  areaRecolectorVerde: AreaP (11,10,11,10)
  areaDepositadorVerde: AreaP (12,10,20,10)
  
  areaBase: AreaC (12,11,12,11)
  
robots

  robot recolectorAzul
  variables
    avanzar: boolean
    avOri, caOri: numero
  comenzar
    avOri:= PosAv
    caOri:= PosCa
    RecibirMensaje(avanzar, rDepoAzul)
    mientras (avanzar = V)
      Pos(10,12)
      tomarFlor
      depositarFlorBase(avOri, caOri)
      EnviarMensaje(V, rDepoAzul)
      RecibirMensaje(avanzar, rDepoAzul)
  fin
  
  robot depositadorAzul
  variables
    avanzar: boolean
  comenzar
    derecha
    mientras (PosAv <> 20)
      EnviarMensaje(V, rRecoAzul)
      RecibirMensaje(avanzar, rRecoAzul)
      buscarFlorBase
      depositarFlor
    EnviarMensaje(F, rRecoAzul)
  fin
  
  robot recolectorVerde
  variables
    avanzar: boolean
    avOri, caOri: numero
  comenzar
    avOri:= PosAv
    caOri:= PosCa
    RecibirMensaje(avanzar, rDepoVerde)
    mientras (avanzar = V)
      Pos(10,10)
      tomarPapel
      depositarPapelBase(avOri, caOri)
      EnviarMensaje(V, rDepoVerde)
      RecibirMensaje(avanzar, rDepoVerde)
  fin
    
  robot depositadorVerde
  variables
    avanzar: boolean
  comenzar
    derecha
    mientras (PosAv <> 20)
      EnviarMensaje(V, rRecoVerde)
      RecibirMensaje(avanzar, rRecoVerde)
      buscarPapelBase
      depositarPapel
    EnviarMensaje(F, rRecoVerde)
  fin 
  
variables
  rRecoAzul: recolectorAzul
  rDepoAzul: depositadorAzul
  rRecoVerde: recolectorVerde
  rDepoVerde: depositadorVerde
comenzar
  AsignarArea(rRecoAzul, areaRecolectorAzul)
  AsignarArea(rDepoAzul, areaDepositadorAzul)
  
  AsignarArea(rRecoVerde, areaRecolectorVerde)
  AsignarArea(rDepoVerde, areaDepositadorVerde)
  
  AsignarArea(rRecoAzul, areaFuenteFlores)
  AsignarArea(rRecoVerde, areaFuentePapeles)
  
  AsignarArea(rRecoAzul, areaBase)
  AsignarArea(rDepoAzul, areaBase)
  AsignarArea(rRecoVerde, areaBase)
  AsignarArea(rDepoVerde, areaBase)
  
  Iniciar(rRecoAzul, 11,12)
  Iniciar(rDepoAzul, 12,12)
  Iniciar(rRecoVerde, 11,10)
  Iniciar(rDepoVerde, 12,10)
fin
